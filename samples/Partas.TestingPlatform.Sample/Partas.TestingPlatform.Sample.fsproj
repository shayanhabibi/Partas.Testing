<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Verification-only: the concrete TRX writer, so the report-trx flag has something
             to bind to. Partas.TestingPlatform.Trx depends on the Abstractions package only. -->
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="[2.4.0,3.0.0)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Partas.TestingPlatform\Partas.TestingPlatform.fsproj"/>
        <ProjectReference Include="..\..\src\Partas.TestingPlatform.CommandLine\Partas.TestingPlatform.CommandLine.fsproj"/>
        <ProjectReference Include="..\..\src\Partas.TestingPlatform.Trx\Partas.TestingPlatform.Trx.fsproj"/>
    </ItemGroup>

</Project>
