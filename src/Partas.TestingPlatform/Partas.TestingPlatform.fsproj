<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(PartasTargetFrameworks)</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <PackageId>Partas.TestingPlatform</PackageId>
        <Title>Partas.TestingPlatform</Title>
        <Description>An F# binding to Microsoft.Testing.Platform.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="TestTree.fs"/>
        <Compile Include="Filtering.fs"/>
        <Compile Include="Discovery.fs"/>
        <None Include="../../README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Testing.Platform" Version="[2.4.0,3.0.0)" />
    </ItemGroup>

</Project>
