<Project Sdk="Microsoft.NET.Sdk">

    <!-- Still the proof of concept. The vertical slice turns this into the packaged library. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>$(PartasTargetFrameworks)</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Testing.Platform" Version="[2.4.0,3.0.0)" />
    </ItemGroup>

</Project>
