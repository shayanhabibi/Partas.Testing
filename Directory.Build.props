<Project>

    <!-- Target frameworks for the shipped packages. Docs and test projects set their own. -->
    <PropertyGroup>
        <PartasTargetFrameworks>net8.0;net10.0</PartasTargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RepositoryUrl>https://github.com/shayanhabibi/Partas.Testing</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>shayanhabibi</Authors>
    </PropertyGroup>


    <!--
    Projects opting out of the root build set IsExcludedFromRootBuild, which
    Directory.Build.targets turns into a no-op Build. Used for Fable projects,
    which are compiled by the fable tool rather than by MSBuild.
    -->
    <PropertyGroup Condition="'$(IsExcludedFromRootBuild)' == 'true'">
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>
