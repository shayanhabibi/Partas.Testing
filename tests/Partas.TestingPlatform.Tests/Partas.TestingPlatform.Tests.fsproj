<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <RootNamespace>Partas.TestingPlatform.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="TestTreeTests.fs"/>
        <Compile Include="Main.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.0.0-alpha8"/>
        <PackageReference Include="Expecto.FsCheck" Version="11.0.0-alpha8-fscheck2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Partas.TestingPlatform\Partas.TestingPlatform.fsproj"/>
    </ItemGroup>

</Project>
