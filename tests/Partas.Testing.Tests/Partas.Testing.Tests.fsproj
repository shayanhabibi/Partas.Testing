<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <RootNamespace>Partas.Testing.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Fakes.fs"/>
        <Compile Include="Tests.fs"/>
        <Compile Include="FocusTests.fs"/>
        <Compile Include="RunnerTests.fs"/>
        <Compile Include="ExpectTests.fs"/>
        <Compile Include="FixtureTests.fs"/>
        <Compile Include="ParallelTests.fs"/>
        <Compile Include="EndToEndTests.fs"/>
        <Compile Include="Main.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.0.0-alpha8"/>
        <PackageReference Include="Expecto.FsCheck" Version="11.0.0-alpha8-fscheck2"/>
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.5"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Partas.Testing\Partas.Testing.fsproj" />
        <!-- Referenced (not opened) so the end-to-end tests in EndToEndTests.fs can launch it
             out-of-process: this expresses the build dependency and copies the sample's dll
             next to this project's own output, at any configuration. -->
        <ProjectReference Include="..\..\samples\Partas.Testing.Sample\Partas.Testing.Sample.fsproj" />
    </ItemGroup>

</Project>
